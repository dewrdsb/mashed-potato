        { "app": "Windows Terminal", "monitor": 1, "rect": "2/3, 0, 1/3, 1" },
        { "app": "Chrome", "monitor": 2, "rect": "0, 0, 1, 1" },
        { "app": "Microsoft Word", "monitor": 1, "rect": "0, 0, 2/3, 1", "instances": "all" },
        { "app": "Obsidian", "monitor": 1, "rect": "1/6, 0, 4/6, 1" },
        { "app": "Spotify", "monitor": 1, "rect": "1/8, 1/8, 6/8, 6/8" },
        { "app": "OneNote", "monitor": 1, "rect": "0, 0, 2/3, 1" },
